# Backend
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Sarvam STT (Builder 2)
SARVAM_API_KEY=

# LLM generation (Builder 2) — pick one provider and fill key
LLM_API_KEY=
LLM_PROVIDER=groq

# Qdrant (Builder 1)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_xi

# Embeddings (Builder 1) — query-time MiniLM via @xenova/transformers (in-process)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional demo gate (Builder 2 — deploy)
DEMO_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Sarvam STT (Builder 2) — https://docs.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=transcribe
SARVAM_LANGUAGE=unknown
SARVAM_MAX_BYTES=5242880
SARVAM_TIMEOUT_MS=30000
# Live mic streaming (WS /api/stt/stream) — uses more Sarvam credits than REST
SARVAM_STREAM_MODEL=saaras:v3
SARVAM_STREAM_SAMPLE_RATE=16000
SARVAM_STREAM_IDLE_MS=120000
SARVAM_WEBSOCKET_URL=wss://api.sarvam.ai/speech-to-text/ws

# LLM generation (Builder 2) — Groq: https://console.groq.com/keys
LLM_API_KEY=
LLM_PROVIDER=groq
# Prefer a fast chat model. Avoid openai/gpt-oss-* (reasoning → 500ms+).
LLM_MODEL=llama-3.3-70b-versatile

# Answer path: extractive (fastest, VANI-like) | hybrid (default) | llm
ANSWER_MODE=hybrid
HYBRID_EXTRACTIVE_MIN_SCORE=0.55
GENERATE_MAX_TOKENS=96
CONTEXT_CHAR_LIMIT=400
RETRIEVE_TOP_K=3
# Post-answer Hindi/Marathi translate (extra LLM call) — keep false for speed
LOCALIZE_ANSWERS=false

# Qdrant (Builder 1)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_xi

# Embeddings (Builder 1) — query-time MiniLM via @xenova/transformers (in-process)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional demo gate (Builder 2 — deploy)
DEMO_PASSWORD=

# Soft rate limits (per IP; /api/query, /api/stt, /api/stt/stream)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Guardrails (Builder 2) — min top retrieval score to allow an answer
GUARDRAIL_MIN_SCORE=0.4

# Pipeline timeouts (ms)
RETRIEVE_TIMEOUT_MS=8000
GENERATE_TIMEOUT_MS=15000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional — must match backend DEMO_PASSWORD when gate is on
NEXT_PUBLIC_DEMO_PASSWORD=
# Silence before auto-submit after live transcript (ms)
NEXT_PUBLIC_VOICE_SILENCE_MS=1500
